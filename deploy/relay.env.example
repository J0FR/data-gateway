# Relay server settings. Copy to relay.env (git-ignored) and fill in.
RELAY_DATABASE_URL=postgresql+psycopg2://relay:CHANGE_ME@localhost:5432/dashboards
RELAY_ADMIN_TOKEN=CHANGE_ME_12_chars_min
# lets the dashboards' refresh button call /api/refresh/<dataset> (optional)
RELAY_DASHBOARD_TOKEN=
# schema where the dataset tables the dashboards read are published
RELAY_DATA_SCHEMA=public
# bind to localhost when a reverse proxy (nginx/Caddy/IIS) provides TLS in front
RELAY_HOST=127.0.0.1
RELAY_PORT=8080
